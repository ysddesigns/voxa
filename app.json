{
  "expo": {
    "name": "Voxa",
    "slug": "voxa",
    "scheme": "voxa",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF4F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voxa.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Voxa listens to the room to write a live transcript. Audio stays on this phone.",
        "NSCameraUsageDescription": "Voxa reads printed text with the camera. Photos are never saved."
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.voxa.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF5A36",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Voxa reads printed text with the camera. Photos stay on this phone.",
          "photosPermission": "Voxa reads text from photos you pick. Photos stay on this phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF4F0",
          "dark": {
            "backgroundColor": "#0E0E0F"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "106d1108-7305-49ee-8019-a9790c819506"
      }
    }
  }
}
