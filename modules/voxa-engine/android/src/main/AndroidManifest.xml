<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Listening with the screen off: microphone foreground service, its notification, and a wake lock. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Speak for me keeps playing with the screen off, with controls on the lock screen. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Android 16 Live Updates: the Listen notification may show as a chip in the status bar. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <!-- Discreet mode routes speech to the earpiece or earbuds. -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <!-- Voice and model packs: download, and check for Wi-Fi before large downloads. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <application>
    <service
      android:name="app.voxa.engine.ListenService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
    <service
      android:name="app.voxa.engine.SpeakService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
  </application>
</manifest>
